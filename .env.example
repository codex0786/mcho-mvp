APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mcho
POSTGRES_USER=mcho
POSTGRES_PASSWORD=change-this-local-password
REDIS_URL=redis://redis:6379/0
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
OIDC_ALGORITHMS=RS256
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=mcho-assets
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
NASA_FIRMS_API_KEY=
MARITIME_PROVIDER=
MARITIME_API_KEY=

# ReliefWeb v2 stays disabled until appname approval, country scope and terms review.
RELIEFWEB_APPNAME=
RELIEFWEB_COUNTRIES=
RELIEFWEB_INITIAL_LOOKBACK_DAYS=7
RELIEFWEB_MAX_PAGES=3
RELIEFWEB_PAGE_SIZE=100
RELIEFWEB_OVERLAP_HOURS=24

# Internal API URL for the local Docker Compose web proxy; leave blank when hosting sets it.
MCHO_API_ORIGIN=http://api:8000
MCHO_WEB_ORIGIN=http://localhost:3000

# Public runtime configuration for the Next.js analyst workspace.
# Configure these only after registering the redirect URL /api/auth/callback with your OIDC provider.
MCHO_OIDC_AUTHORITY=
MCHO_OIDC_CLIENT_ID=
MCHO_OIDC_RESOURCE=
MCHO_MAP_STYLE_URL=
